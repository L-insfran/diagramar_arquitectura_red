# Variables para despliegue en VM (Portainer + Postgres existente).
# Copiar a la raíz del proyecto como `.env` (no commitear secretos):
#   cp docker/env.example .env
#
# Destino típico en la VM:
#   /home/adminpx/contenedores/diagramar_arquitectura_red

# --- App ---
# Debe ser el MISMO APP_KEY que en tu PC; si cambia, secretos cifrados del dump no se descifran.
APP_KEY=network-manager-secret-key-2024!!

# --- PostgreSQL (contenedor ya existente en la VM) ---
# Si backend y Postgres comparten red Docker, DB_HOST = nombre del contenedor Postgres.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar_password
DB_DATABASE=network_manager

# Nombre de la red Docker del contenedor Postgres
# (Portainer → Contenedor Postgres → Networks). Ejemplo: postgres_default
POSTGRES_NETWORK=postgres_default

# --- Logging ---
LOG_LEVEL=info
